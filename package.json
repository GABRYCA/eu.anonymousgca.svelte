{
	"name": "anonymousgca-website",
	"version": "1.9.7",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/check-energy-history.mjs && vite build",
		"data:energy": "bun scripts/fetch-energy-history.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && bun --no-env-file check --no-script && svelte-check --tsconfig ./jsconfig.json",
		"check:types": "bun --no-env-file check --no-script",
		"format": "bun fmt --check --changed",
		"format:write": "bun fmt --changed"
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/roboto-mono": "^5.3.0",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"bootstrap": "^5.3.8",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-tooltip-gca": "^1.1.0",
		"vite": "^8.3.5"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
