{
	"name": "anonymousgca-website",
	"version": "1.9.0",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/check-energy-history.mjs && vite build",
		"data:energy": "bun scripts/fetch-energy-history.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"format": "prettier --check .",
		"format:write": "prettier --write ."
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/roboto-mono": "^5.3.0",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"bootstrap": "^5.3.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-tooltip-gca": "^1.0.5",
		"vite": "^8.3.2"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
